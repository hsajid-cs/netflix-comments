{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": ["node", "chrome"],
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": ["tests/**/*.test.ts"]
}
