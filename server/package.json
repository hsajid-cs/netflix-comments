{
  "name": "netflix-comments-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
